  "MinimaxH3LatentUpscaler3D": {
    "desc": "H3 latent 3D 放大（双 VAE 解码）",
    "repo": "LBH-123-AI/Comfyui_Minimax_h3_latent_Upscaler",
    "params": {
      "model_name": {
        "type": "COMBO",
        "default": "minimax_h3_latent_upscaler_3d_fp16.safetensors",
