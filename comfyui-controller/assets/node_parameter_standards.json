      "mode.scale": {
        "type": "FLOAT",
        "default": 1.5,
        "range": ">1",
        "meaning": "放大倍数",
        "required": true
      },
      "align": {
        "type": "INT",
        "default": 32,
        "range": "16/32",
        "meaning": "对齐网格",
        "required": false
      },
      "keep_proportion": {
        "type": "COMBO",
        "default": "cuda",
        "range": "cuda / ...",
        "meaning": "比例保持",
        "required": false
      },
      "device": {
        "type": "COMBO",
        "default": "fp16",
        "range": "fp16 / fp32",
        "meaning": "计算精度",
        "required": false
      },
      "precision": {
        "type": "BOOLEAN",
        "default": false,
        "range": "true/false",
        "meaning": "高精度开关",
        "required": false
      },
      "offload_after_upscale": {
        "type": "BOOLEAN",
        "default": false,
        "range": "true/false",
        "meaning": "放大后卸载",
        "required": false
      }
    },
    "note": null
  },
