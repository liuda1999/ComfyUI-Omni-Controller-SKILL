{
  "UNETLoader": {
    "desc": "加载 H3 DiT 扩散模型（diffusion_models）",
    "repo": "ComfyUI 核心",
    "params": {
      "unet_name": {
        "type": "COMBO",
        "default": "-",
        "range": "models/diffusion_models/ 下 .safetensors",
        "meaning": "模型文件名；如 minimax_h3_ref2va_pruned_fp8_scaled.safetensors",
        "required": true
      },
      "weight_dtype": {
        "type": "COMBO",
        "default": "default",
        "range": "default / fp8_e4m3fn / fp8_e5m2 / fp16 / bf16",
        "meaning": "加载精度；默认由文件决定，低显存可选 fp8",
        "required": false
      }
    },
    "note": null
  },
  "CLIPLoader": {
    "desc": "加载 Qwen3-VL 文本编码器",
    "repo": "ComfyUI 核心",
    "params": {
      "clip_name": {
        "type": "COMBO",
        "default": "-",
        "range": "models/text_encoders/ 下 .safetensors",
        "meaning": "如 qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors",
        "required": true
      },
      "type": {
        "type": "COMBO",
        "default": "minimax",
        "range": "minimax / ...",
        "meaning": "编码器类型；H3 须选 minimax",
        "required": true
      },
      "device": {
        "type": "COMBO",
        "default": "default",
        "range": "default / cpu",
        "meaning": "加载设备",
        "required": false
      }
    },
    "note": null
  },
  "VAELoader": {
    "desc": "加载 VAE（视频或音频）",
    "repo": "ComfyUI 核心",
    "params": {
      "vae_name": {
        "type": "COMBO",
        "default": "-",
        "range": "models/vae/ 下 .safetensors",
        "meaning": "如 minimax_h3_video_vae_fp16.safetensors（视频）/ minimax_h3_audio_vae_fp32（音频，须 fp32）",
        "required": true
      }
    },
    "note": null
  },
  "LoraLoaderModelOnly": {
    "desc": "仅作用于模型的 LoRA 加载（不接 CLIP）",
    "repo": "ComfyUI 核心",
    "params": {
      "lora_name": {
        "type": "COMBO",
        "default": "-",
        "range": "models/loras/ 下 .safetensors",
        "meaning": "LoRA 文件名",
        "required": true
      },
      "strength_model": {
        "type": "FLOAT",
        "default": 1.0,
        "range": "-10 ~ 10",
        "meaning": "模型侧强度，1=原强度",
        "required": false
      }
    },
    "note": null
  },
  "MiniMaxH3TurboLoRA": {
    "desc": "H3 Turbo 加速 LoRA 注入",
    "repo": "Larryvrh/ComfyUI-MiniMax-H3-Turbo",
    "params": {
      "lora_name": {
        "type": "COMBO",
        "default": "-",
        "range": "models/loras/ 下 .safetensors",
        "meaning": "如 minimax_h3_fl2v_turbo_4step_v1.2_768p_..._bf16.safetensors",
        "required": true
      },
      "strength": {
        "type": "FLOAT",
        "default": 1.0,
        "range": "0~2",
        "meaning": "LoRA 强度",
        "required": false
      },
      "low_vram": {
        "type": "BOOLEAN",
        "default": false,
        "range": "true/false",
        "meaning": "低显存模式",
        "required": false
      }
    },
    "note": null
  },
  "BasicScheduler": {
    "desc": "生成采样 sigma 序列",
    "repo": "ComfyUI 核心",
    "params": {
      "scheduler": {
        "type": "COMBO",
        "default": "simple",
        "range": "simple / normal / karras / ddim_uniform / sgm_uniform / beta / ...",
        "meaning": "调度器；H3 常用 simple",
        "required": true
      },
      "steps": {
        "type": "INT",
        "default": 20,
        "range": "1~50（Turbo 4 步 / 8 步）",
        "meaning": "去噪步数",
        "required": true
      },
      "denoise": {
        "type": "FLOAT",
        "default": 1.0,
        "range": "0~1",
        "meaning": "降噪强度；图生视频常 <1",
        "required": false
      }
    },
    "note": null
  },
  "BasicGuider": {
    "desc": "用条件与模型构造引导器",
    "repo": "ComfyUI 核心",
    "params": {},
    "note": null
  },
  "RandomNoise": {
    "desc": "随机噪声源",
    "repo": "ComfyUI 核心",
    "params": {
      "noise_seed": {
        "type": "INT",
        "default": 0,
        "range": "0~2^53",
        "meaning": "随机种子",
        "required": true
      },
      "control_after_generate": {
        "type": "COMBO",
        "default": "randomize",
        "range": "randomize / fixed / increment / decrement",
        "meaning": "生成后种子行为",
        "required": false
      }
    },
    "note": null
  },
  "SamplerCustomAdvanced": {
    "desc": "自定义采样（guider+sampler+sigmas+noise→latent）",
    "repo": "ComfyUI 核心",
    "params": {},
    "note": null
  },
  "KSamplerSelect": {
    "desc": "选择采样器算法",
    "repo": "ComfyUI 核心",
    "params": {
      "sampler_name": {
        "type": "COMBO",
        "default": "euler",
        "range": "euler / ddim / uni_pc / res_2s / er_sde / ...",
        "meaning": "采样器；H3 常用 ddim / er_sde",
        "required": true
      }
    },
    "note": null
  },
  "SplitSigmas": {
    "desc": "将 sigma 序列按阈值拆分",
    "repo": "ComfyUI 核心",
    "params": {
      "split_at": {
        "type": "FLOAT",
        "default": 0,
        "range": "0~1",
        "meaning": "拆分位置（sigma 比例）",
        "required": true
      }
    },
    "note": null
  },
  "MiniMaxH3SigmaShift": {
    "desc": "H3 专用 sigma 偏移（视频/音频分别）",
    "repo": "ComfyUI 原生 (>=0.30.0)",
    "params": {
      "shift_video": {
        "type": "FLOAT",
        "default": 12,
        "range": "H3 官方默认 12",
        "meaning": "视频流 shift",
        "required": false
      },
      "shift_audio": {
        "type": "FLOAT",
        "default": 3,
        "range": "H3 官方默认 3",
        "meaning": "音频流 shift",
        "required": false
      }
    },
    "note": null
  },
  "MiniMaxH3ContextLatentTaperNoise": {
    "desc": "首尾帧/长视频噪声锥度（H3 长视频关键节点）",
    "repo": "beijinren/ComfyUI-H3-Context-Noise",
    "params": {
      "tail_frames": {
        "type": "STRING",
        "default": "22",
        "range": "整数",
        "meaning": "尾部锥度帧数",
        "required": true
      },
      "alpha": {
        "type": "FLOAT",
        "default": 0.45,
        "range": "0~1",
        "meaning": "起始噪声混合比例",
        "required": false
      },
      "alpha_end": {
        "type": "FLOAT",
        "default": 0.1,
        "range": "0~1",
        "meaning": "结束噪声混合比例",
        "required": false
      },
      "ramp_steps": {
        "type": "INT",
        "default": 2,
        "range": "≥1",
        "meaning": "锥度过渡步数",
        "required": false
      },
      "seed": {
        "type": "INT",
        "default": 0,
        "range": "0~2^53",
        "meaning": "种子",
        "required": true
      },
      "control_after_generate": {
        "type": "COMBO",
        "default": "randomize",
        "range": "randomize/fixed/...",
        "meaning": "种子行为",
        "required": false
      },
      "noise_scale": {
        "type": "COMBO",
        "default": "match_latent_std",
        "range": "match_latent_std / ...",
        "meaning": "噪声缩放方式",
        "required": false
      }
    },
    "note": null
  },
  "MiniMaxH3ImageToVideo": {
    "desc": "H3 文/图生视频主节点（含首尾帧）",
    "repo": "ComfyUI 原生 (>=0.30.0)",
    "params": {
      "prompt": {
        "type": "STRING",
        "default": "",
        "range": "文本",
        "meaning": "正向提示词",
        "required": true
      },
      "width": {
        "type": "INT",
        "default": 1344,
        "range": "32 的倍数，如 768/1344",
        "meaning": "视频宽",
        "required": true
      },
      "height": {
        "type": "INT",
        "default": 768,
        "range": "32 的倍数，如 768/1344",
        "meaning": "视频高",
        "required": true
      },
      "length": {
        "type": "INT",
        "default": 124,
        "range": "H3 网格对齐（约 4 的倍数帧）",
        "meaning": "帧数",
        "required": true
      },
      "ref_image_size": {
        "type": "COMBO",
        "default": "match",
        "range": "match / 256 / 512 / ...",
        "meaning": "参考图分辨率",
        "required": false
      }
    },
    "note": null
  },
  "MiniMaxH3ReferenceToVideo": {
    "desc": "H3 多参考图生视频主节点",
    "repo": "ComfyUI 原生 (>=0.30.0)",
    "params": {
      "prompt": {
        "type": "STRING",
        "default": "",
        "range": "文本",
        "meaning": "正向提示词",
        "required": true
      },
      "width": {
        "type": "INT",
        "default": 1344,
        "range": "32 倍数",
        "meaning": "宽",
        "required": true
      },
      "height": {
        "type": "INT",
        "default": 768,
        "range": "32 倍数",
        "meaning": "高",
        "required": true
      },
      "length": {
        "type": "INT",
        "default": 124,
        "range": "帧数（H3 对齐）",
