      },
      "ref_image_size": {
        "type": "COMBO",
        "default": "match",
        "range": "match/256/512",
        "meaning": "参考图尺寸",
        "required": false
      }
    },
    "note": null
  },
  "MiniMaxH3TurboSampler": {
    "desc": "H3 Turbo 采样器（无 widget，参数经连线输入）",
    "repo": "Larryvrh/ComfyUI-MiniMax-H3-Turbo",
    "inputs": [
      "model",
      "conditioning",
      "latent_image",
      "steps(可选)",
      "vae",
      "vae_1",
      "sampler_name",
      "scheduler",
      "denoise"
    ],
    "note": "该节点无 widgets_values；其参数（步数/调度器/双 VAE 等）由上游连线提供，详见工作流连线。"
  },
  "SelfLiftH3Sampler": {
    "desc": "Self-Lift 自提升采样器（含 latent 放大）",
    "repo": "facok/comfyui-SelfLift",
    "params": {
      "seed": {
        "type": "INT",
        "default": 0,
        "range": "0~2^53",
        "meaning": "种子",
        "required": true
      },
      "control_after_generate": {
        "type": "COMBO",
        "default": "randomize",
        "range": "randomize/fixed",
        "meaning": "种子行为",
        "required": false
      },
      "cfg": {
        "type": "FLOAT",
        "default": 1,
        "range": "1~10（H3 常取 1）",
        "meaning": "分类器自由引导",
        "required": false
      },
      "transition_step": {
        "type": "INT",
        "default": 8,
        "range": "≥0",
        "meaning": "转换步",
        "required": false
      },
      "lowres_scale": {
        "type": "FLOAT",
        "default": 0.4,
        "range": "0~1",
        "meaning": "低分辨率比例",
        "required": false
      },
      "rho": {
        "type": "FLOAT",
        "default": 0,
        "range": "≥0",
        "meaning": "rho",
        "required": false
      },
      "w_min": {
        "type": "FLOAT",
        "default": 0.2,
        "range": "0~1",
        "meaning": "权重下限",
        "required": false
      },
      "w_max": {
        "type": "FLOAT",
        "default": 1,
        "range": "0~1",
        "meaning": "权重上限",
        "required": false
      },
      "upscaler_model": {
        "type": "COMBO",
        "default": "minimax_h3_latent_upscaler_3d_fp16.safetensors",
        "range": "models/latent_upscale_models/",
        "meaning": "放大模型",
        "required": false
      },
      "highres_tiling": {
        "type": "BOOLEAN",
        "default": true,
        "range": "true/false",
        "meaning": "高分块处理",
        "required": false
      }
    },
    "note": null
  },
  "H3SigmaRefiner": {
    "desc": "H3 sigma 精修（在指定 sigma 区间额外步数）",
